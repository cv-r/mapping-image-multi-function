{
  "name": "mapping-image-multi-function",
  "version": "1.0.7",
  "description": "Browser utility for image URL to Base64 conversion and Base64 compression",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": ["base64", "image", "compress", "canvas", "browser", "encoding"],
  "author": "zhouyun930629",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cv-r/mapping-image-multi-function.git"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
